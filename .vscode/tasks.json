{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Project Pulse",
      "type": "shell",
      "command": "python3 -m http.server 5500",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "isBackground": true,
     "problemMatcher": {
          "owner": "custom",
          "pattern": {
              "regexp": "^(.*?):(\\d+):\\s+(.*)$",
              "file": 1,
              "line": 2,
              "message": 3
          },
          "background": {
              "activeOnStart": true,
              "beginsPattern": "Serving HTTP on",
              "endsPattern": "port \\d+"
          }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
